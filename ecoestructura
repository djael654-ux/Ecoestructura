# Ecoestructura<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoEstructura · Chequeo del Negocio</title>
<style>
  :root{
    --verde:#2e7d32;
    --verde-oscuro:#1b5e20;
    --verde-claro:#e8f5e9;
    --naranja:#ff7043;
    --amarillo:#fbc02d;
    --rojo:#e53935;
    --fondo:#f4faf5;
    --texto:#1f3a24;
    --suave:#6b7d70;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;
    background:linear-gradient(160deg,#fff8e1 0%,#e8f5e9 100%);
    color:var(--texto);
    min-height:100vh;
    padding:20px 14px 60px;
    line-height:1.5;
  }
  .contenedor{max-width:760px;margin:0 auto}

  .encabezado{
    background:linear-gradient(135deg,#e65100 0%,#ff7043 50%,#ffb74d 100%);
    color:#fff;
    padding:28px 22px;
    border-radius:22px;
    margin-bottom:20px;
    box-shadow:0 10px 30px rgba(230,81,0,.25);
    position:relative;
    overflow:hidden;
  }
  .encabezado::after{
    content:"🌮🍔🥡";
    position:absolute;right:-10px;top:-10px;
    font-size:5rem;opacity:.18;transform:rotate(-10deg);
  }
  .encabezado h1{font-size:1.65rem;letter-spacing:-.5px;margin-bottom:6px}
  .encabezado .subtitulo{font-size:.95rem;opacity:.95;margin-bottom:14px}
  .insignias{display:flex;gap:8px;flex-wrap:wrap;font-size:.78rem}
  .insignia{
    background:rgba(255,255,255,.22);
    padding:5px 11px;border-radius:99px;
    border:1px solid rgba(255,255,255,.3);
  }

  .pantalla{display:none;animation:entrar .35s ease}
  .pantalla.activa{display:block}
  @keyframes entrar{
    from{opacity:0;transform:translateY(15px)}
    to{opacity:1;transform:translateY(0)}
  }

  .tarjeta-inicio{
    background:#fff;padding:32px 24px;
    border-radius:22px;text-align:center;
    box-shadow:0 6px 20px rgba(0,0,0,.06);
    border-top:5px solid var(--naranja);
  }
  .tarjeta-inicio .emoji-grande{font-size:4.5rem;margin-bottom:8px;animation:saludar 2.5s infinite}
  @keyframes saludar{0%,100%{transform:rotate(0)}25%{transform:rotate(-10deg)}75%{transform:rotate(10deg)}}
  .tarjeta-inicio h2{color:#bf360c;font-size:1.35rem;margin-bottom:8px}
  .tarjeta-inicio p{color:var(--suave);margin-bottom:18px}
  .tarjeta-inicio ul{text-align:left;list-style:none;margin:18px 0}
  .tarjeta-inicio li{padding:7px 0;color:#445;display:flex;align-items:center;gap:10px}
  .tarjeta-inicio li::before{content:"✓";color:var(--verde);font-weight:800;font-size:1.1rem}

  .boton{
    border:none;border-radius:99px;
    padding:13px 26px;
    font-size:1rem;font-weight:700;
    cursor:pointer;transition:all .2s;
    font-family:inherit;
  }
  .boton-principal{
    background:linear-gradient(135deg,var(--naranja),#e65100);
    color:#fff;
    box-shadow:0 6px 16px rgba(230,81,0,.3);
  }
  .boton-principal:hover{transform:translateY(-2px);box-shadow:0 10px 22px rgba(230,81,0,.45)}
  .boton-fantasma{background:transparent;color:var(--verde);border:2px solid var(--verde);margin-top:10px}
  .boton-fantasma:hover{background:var(--verde-claro)}

  .progreso{display:flex;align-items:center;gap:10px;margin-bottom:14px;font-size:.82rem;color:var(--suave)}
  .barra-progreso{flex:1;height:9px;background:#e0e0e0;border-radius:99px;overflow:hidden}
  .barra-relleno{height:100%;background:linear-gradient(90deg,var(--naranja),var(--amarillo));border-radius:99px;transition:width .4s}
  .corazon{font-size:1rem}

  .tarjeta{
    background:#fff;padding:24px 22px;
    border-radius:22px;
    box-shadow:0 6px 20px rgba(0,0,0,.06);
    border-left:5px solid var(--naranja);
  }
  .etiqueta-paso{
    display:inline-block;
    background:#fff3e0;color:#bf360c;
    padding:3px 11px;border-radius:99px;
    font-size:.7rem;font-weight:700;
    text-transform:uppercase;letter-spacing:.5px;
    margin-bottom:10px;
  }
  .pregunta{font-size:1.15rem;font-weight:700;margin-bottom:6px;color:#263326}
  .pregunta .resaltado{color:var(--naranja)}
  .pista{font-size:.85rem;color:var(--suave);margin-bottom:16px;font-style:italic}

  .campo{margin-bottom:13px}
  .campo label{display:block;font-size:.82rem;font-weight:600;color:#445;margin-bottom:5px}
  .campo input,.campo select,.campo textarea{
    width:100%;padding:11px 14px;
    border:2px solid #e0e0e0;border-radius:12px;
    font-size:.95rem;font-family:inherit;
    background:#fafafa;transition:.15s;
  }
  .campo textarea{min-height:80px;resize:vertical}
  .campo input:focus,.campo select:focus,.campo textarea:focus{
    outline:none;border-color:var(--naranja);background:#fff;
  }

  .opciones{display:grid;gap:9px}
  .opciones.dos{grid-template-columns:1fr 1fr}
  .opcion{
    display:flex;align-items:center;gap:11px;
    padding:13px 14px;
    border:2px solid #ececec;border-radius:14px;
    cursor:pointer;background:#fff;
    transition:.15s;font-size:.93rem;
  }
  .opcion:hover{border-color:var(--naranja);background:#fff3e0;transform:translateX(2px)}
  .opcion.seleccionada{border-color:var(--naranja);background:#fff3e0;box-shadow:0 4px 12px rgba(255,112,67,.18)}
  .opcion input{display:none}
  .opcion .icono{font-size:1.4rem;min-width:32px;text-align:center}
  .opcion .texto{flex:1}
  .opcion .texto b{display:block;color:#263326;margin-bottom:1px}
  .opcion .texto small{color:var(--suave);font-size:.78rem}

  .termometro{display:flex;gap:6px;margin:14px 0}
  .termometro label{flex:1;cursor:pointer}
  .termometro input{display:none}
  .termometro .barra{
    height:48px;border-radius:10px;
    display:flex;align-items:center;justify-content:center;
    font-weight:700;color:#fff;font-size:.85rem;
    background:#e0e0e0;color:#888;
    transition:.15s;
  }
  .termometro label:nth-child(1) .barra{background:#ef9a9a}
  .termometro label:nth-child(2) .barra{background:#ffab91}
  .termometro label:nth-child(3) .barra{background:#ffcc80}
  .termometro label:nth-child(4) .barra{background:#aed581}
  .termometro label:nth-child(5) .barra{background:#66bb6a}
  .termometro label:hover .barra{transform:scale(1.04)}
  .termometro input:checked + .barra{
    transform:scale(1.08);
    box-shadow:0 4px 14px rgba(0,0,0,.18);
    border:3px solid #fff;
    outline:2px solid currentColor;
  }

  .tarjetas-empaque{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
  .tarjeta-empaque{
    border:2px solid #ececec;border-radius:14px;
    padding:14px;text-align:center;cursor:pointer;
    background:#fff;transition:.15s;
  }
  .tarjeta-empaque:hover{border-color:var(--naranja);transform:translateY(-2px)}
  .tarjeta-empaque.seleccionada{border-color:var(--naranja);background:#fff3e0}
  .tarjeta-empaque input{display:none}
  .tarjeta-empaque .icono-empaque{font-size:2.2rem;margin-bottom:4px}
  .tarjeta-empaque .nombre{font-size:.85rem;font-weight:700}
  .tarjeta-empaque .detalle{font-size:.72rem;color:var(--suave);margin-top:3px}

  .campo-costo{
    display:flex;gap:8px;align-items:center;
    background:#fafafa;border:2px solid #e0e0e0;
    border-radius:14px;padding:8px 12px;margin-top:10px;
  }
  .campo-costo .simbolo{font-weight:700;color:#bf360c}
  .campo-costo input{
    flex:1;border:none;background:transparent;
    font-size:1.1rem;font-weight:700;padding:6px;
  }
  .campo-costo input:focus{outline:none}

  .envoladura-control{margin:18px 0}
  .valor-carrusel{
    text-align:center;font-size:1.4rem;font-weight:800;
    color:#bf360c;margin-bottom:8px;
  }
  .carrusel{
    width:100%;-webkit-appearance:none;height:8px;
    border-radius:99px;background:#e0e0e0;outline:none;
  }
  .carrusel::-webkit-slider-thumb{
    -webkit-appearance:none;width:24px;height:24px;
    border-radius:50%;background:var(--naranja);
    cursor:pointer;border:3px solid #fff;
    box-shadow:0 2px 6px rgba(0,0,0,.2);
  }
  .carrusel::-moz-range-thumb{
    width:24px;height:24px;border-radius:50%;
    background:var(--naranja);cursor:pointer;border:3px solid #fff;
  }
  .etiquetas-carrusel{display:flex;justify-content:space-between;font-size:.72rem;color:var(--suave);margin-top:4px}

  .lista-chequeo{display:grid;gap:8px;margin-top:10px}
  .item-chequeo{
    display:flex;align-items:center;gap:10px;
    padding:11px 14px;border:2px solid #ececec;
    border-radius:12px;cursor:pointer;background:#fff;
    transition:.15s;
  }
  .item-chequeo:hover{border-color:var(--naranja);background:#fff8f3}
  .item-chequeo.seleccionada{border-color:var(--naranja);background:#fff3e0}
  .item-chequeo input{display:none}
  .item-chequeo .casilla{
    width:22px;height:22px;border:2px solid #ccc;
    border-radius:6px;display:flex;align-items:center;
    justify-content:center;flex-shrink:0;transition:.15s;
  }
  .item-chequeo.seleccionada .casilla{
    background:var(--naranja);border-color:var(--naranja);
    color:#fff;
  }
  .item-chequeo.seleccionada .casilla::before{content:"✓";font-weight:800;font-size:.9rem}

  .escenario{
    background:linear-gradient(135deg,#fff8e1 0%,#fff3e0 100%);
    border-left:4px solid var(--naranja);
    padding:14px;border-radius:12px;margin-bottom:14px;
  }
  .escenario h4{color:#bf360c;font-size:.95rem;margin-bottom:4px}
  .escenario p{color:#666;font-size:.85rem}

  .tarjeta-resultado{
    background:linear-gradient(135deg,#fff 0%,#fff8e1 100%);
    padding:28px 22px;border-radius:22px;text-align:center;
    box-shadow:0 8px 24px rgba(0,0,0,.08);
    border:2px solid var(--naranja);
  }
  .medalla{font-size:4.5rem;animation:girar 3s infinite}
  @keyframes girar{0%,100%{transform:rotate(0)}50%{transform:rotate(15deg)}}
  .tarjeta-resultado h2{color:#bf360c;margin:8px 0;font-size:1.4rem}
  .puntaje-grande{
    font-size:2.5rem;font-weight:800;
    background:linear-gradient(135deg,var(--naranja),var(--verde));
    -webkit-background-clip:text;-webkit-text-fill-color:transparent;
    background-clip:text;
  }
  .nivel-resultado{
    display:inline-block;background:var(--verde);color:#fff;
    padding:6px 16px;border-radius:99px;font-weight:700;
    font-size:.9rem;margin:10px 0;
  }
  .recomendaciones{
    background:#fff;padding:16px;border-radius:14px;
    margin-top:14px;text-align:left;
    border:2px dashed #ffcc80;
  }
  .recomendaciones h4{color:#bf360c;margin-bottom:8px;font-size:.95rem}
  .recomendaciones li{padding:4px 0;color:#445;font-size:.87rem;list-style:none}
  .recomendaciones li::before{content:"💡 ";margin-right:6px}

  .navegacion{display:flex;justify-content:space-between;gap:10px;margin-top:18px}
  .navegacion .boton{padding:11px 22px;font-size:.92rem}

  @media(max-width:540px){
    .encabezado{padding:22px 18px}
    .encabezado h1{font-size:1.4rem}
    .tarjeta{padding:20px 16px}
    .opciones.dos{grid-template-columns:1fr}
    .tarjetas-empaque{grid-template-columns:1fr}
    .termometro .barra{font-size:.7rem;height:42px}
  }
</style>
</head>
<body>
<div class="contenedor">

<!-- ENCABEZADO -->
<div class="encabezado">
  <h1>🌶️ Chequeo del Negocio 📊</h1>
  <p class="subtitulo">Diagnóstico rápido para tu negocio de comida. Sin enredos ni formularios eternos.</p>
  <div class="insignias">
    <span class="insignia">⏱️ 5 minutos</span>
    <span class="insignia">🎯 De 18 a 23 años</span>
    <span class="insignia">🧑‍🍳 Food trucks y cocinas ocultas</span>
    <span class="insignia">🏅 10 niveles</span>
  </div>
</div>

<!-- ========== P1: INICIO ========== -->
<div class="pantalla activa" id="n-inicio">
  <div class="tarjeta-inicio">
    <div class="emoji-grande">🌮🧑‍🍳</div>
    <h2>¿Manejas o haces parte de un negocio de comida?</h2>
    <p>Food truck, cocina oculta, local, emprendimiento desde tu casa, el que más vende en tu barrio… Si vendes comida para llevar, este chequeo es para ti.</p>
    <ul>
      <li>Descubre qué tan listo estás para usar un empaque biodegradable</li>
      <li>Solo te lleva 5 minutos, sin formularios eternos</li>
      <li>Al final te llevas tu <b>nivel de madurez verde</b> 🌿</li>
      <li>Si quieres, te contactamos para una prueba piloto gratis 🎁</li>
    </ul>
    <button class="boton boton-principal" onclick="ir(1)">⚡ Empezar diagnóstico</button>
    <p style="margin-top:14px;font-size:.78rem;color:var(--suave)">EcoEstructura · Proyecto de Producto y Consumidor · UJTL</p>
  </div>
</div>

<!-- ========== P2: PERFIL ========== -->
<div class="pantalla" id="n-perfil">
  <div class="progreso">
    <span>Pregunta <b>1</b> de 9</span>
    <div class="barra-progreso"><div class="barra-relleno" style="width:11%"></div></div>
    <span class="corazon">🔥 0</span>
  </div>

  <div class="tarjeta">
    <span class="etiqueta-paso">🪪 Paso 1 · Tu negocio en 30 segundos</span>
    <div class="pregunta">¿Cuál es tu edad?</div>
    <div class="pista">Necesitamos esto para filtrar la muestra del proyecto</div>
    <div class="campo">
      <select id="neg_edad">
        <option value="">Elige tu edad</option>
        <option>18</option><option>19</option><option>20</option>
        <option>21</option><option>22</option><option>23</option>
      </select>
    </div>

    <div class="pregunta" style="margin-top:14px">¿Cómo es tu negocio?</div>
    <div class="pista">Elige el que más se parezca al tuyo</div>

    <div class="opciones dos">
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="food_truck">
        <span class="icono">🚚</span>
        <span class="texto"><b>Food truck</b><small>Callejero o de eventos</small></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="cocina_oculta">
        <span class="icono">🏠</span>
        <span class="texto"><b>Cocina oculta</b><small>Solo domicilios</small></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="local">
        <span class="icono">🏪</span>
        <span class="texto"><b>Local o restaurante pequeño</b></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="casa">
        <span class="icono">👩‍🍳</span>
        <span class="texto"><b>Emprendimiento desde casa</b></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="startup">
        <span class="icono">🚀</span>
        <span class="texto"><b>Startup de comida</b></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_tipo" value="otro">
        <span class="icono">✨</span>
        <span class="texto"><b>Otro</b></span>
      </label>
    </div>

    <div class="campo" style="margin-top:14px">
      <label>¿Cómo se llama o cómo le dicen a tu negocio? <span style="color:var(--suave);font-weight:400">(opcional)</span></label>
      <input type="text" id="neg_nombre" placeholder="Ejemplo: Las Empanadas de la Esquina">
    </div>
  </div>

  <div class="navegacion">
    <button class="boton boton-fantasma" onclick="ir(0)">← Volver</button>
    <button class="boton boton-principal" onclick="validarYSiguiente(1,2)">Siguiente ⚡</button>
  </div>
</div>

<!-- ========== P3: VOLUMEN ========== -->
<div class="pantalla" id="n-volumen">
  <div class="progreso">
    <span>Pregunta <b>2</b> de 9</span>
    <div class="barra-progreso"><div class="barra-relleno" style="width:22%"></div></div>
    <span class="corazon">🔥 1</span>
  </div>

  <div class="tarjeta">
    <span class="etiqueta-paso">📦 Paso 2 · ¿Cuánta comida sale por semana?</span>
    <div class="pregunta">¿Cuántos pedidos para llevar o a domicilio manejas <span class="resaltado">por semana</span>?</div>
    <div class="pista">Aproxímate, no es una auditoría tributaria 😄</div>

    <div class="opciones">
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_volumen" value="menos_30">
        <span class="icono">📦</span>
        <span class="texto"><b>Menos de 30</b><small>Estoy empezando</small></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_volumen" value="30-100">
        <span class="icono">📦📦</span>
        <span class="texto"><b>Entre 30 y 100</b><small>Ya tengo clientela fiel</small></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_volumen" value="100-300">
        <span class="icono">📦📦📦</span>
        <span class="texto"><b>Entre 100 y 300</b><small>Volumen fuerte</small></span>
      </label>
      <label class="opcion" onclick="elegirUna(this)">
        <input type="radio" name="neg_volumen" value="mas_300">
        <span class="icono">📦📦📦📦</span>
        <span class="texto"><b>Más de 300</b><small>Operación grande</small></span>
      </label>
    </div>

    <div style="margin-top:18px">
      <p style="font-weight:600;margin-bottom:8px">¿Cuánto gastas al mes en empaques desechables? (aproximado)</p>
      <div class="campo-costo">
        <span class="simbolo">$</span>
        <input type="number" id="neg_costo" placeholder="200.000" min="0">
        <span class="simbolo" style="color:var(--suave)">COP</span>
      </div>
      <p style="font-size:.78rem;color:var(--suave);margin-top:6px">💡 Si no lo sabes exacto, da un aproximado.</p>
    </div>
  </div>

  <div class="navegacion">
    <button class="boton boton-fantasma" onclick="ir(1)">← Volver</button>
    <button class="boton boton-principal" onclick="validarYSiguiente(2,3)">Siguiente ⚡</button>
  </div>
</div>

<!-- ========== P4: EMPAQUE ACTUAL ========== -->
<div class="pantalla" id="n-empaque">
  <div class="progreso">
    <span>Pregunta <b>3</b> de 9</span>
    <div class="barra-progreso"><div class="barra-relleno" style="width:33%"></div></div>
    <span class="corazon">🔥 2</span>
  </div>

  <div class="tarjeta">
    <span class="etiqueta-paso">🥡 Paso 3 · Tu empaque hoy</span>
    <div class="pregunta">¿Qué tipo de empaque usas <span class="resaltado">ahora</span>?</div>
    <div class="pista">El principal, el que más sale por la puerta</div>

    <div class="tarjetas-empaque">
      <label class="tarjeta-empaque" onclick="elegirTarjeta(this)">
        <input type="radio" name="neg_actual" value="icopor">
        <div class="icono-empaque">🥡</div>
        <div class="nombre">Icopor</div>
        <div class="detalle">Poliestireno expandido</div>
      </label>
      <label class="tarjeta-empaque" onclick="elegirTarjeta(this)">
        <input type="radio" name="neg_actual" value="plastico">
        <div class="icono-empaque">🛍️</div>
        <div class="nombre">Plástico</div>
        <div class="detalle">PET, polipropileno</div>
      </label>
      <label class="tarjeta-empaque" onclick="elegirTarjeta(this)">
        <input type="radio" name="neg_actual" value="carton">
        <div class="icono-empaque">📦</div>
        <div class="nombre">Cartón genérico</div>
        <div class="detalle">Sin marca</div>
      </label>
      <label class="tarjeta-empaque" onclick="elegirTarjeta(this)">
        <input type="radio" name="neg_actual" value="kraft">
        <div class="icono-empaque">🌿</div>
        <div class="nombre">Kraft o papel</div>
        <div class="detalle">Más ecológico</div>
      </label>
      <label class="tarjeta-empaque" onclick="elegirTarjeta(this)">
        <input type="radio" name="neg_actual" value="biodegradable">
        <div class="icono-empaque">🌱</div>
        <div class="nombre">Biodegradable</div>
        <div class="detalle">Bagazo o EarthPact</div>
      </label>
