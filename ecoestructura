<script>
const pantallas=['inicio','perfil','volumen','empaque','quejas','ley','atributos','decision','pago','final','resultado'];
let actual=0;
const barras={precio:5,funcional:5,certif:5,marca:5};

function ir(indice){
  document.querySelectorAll('.pantalla').forEach(p=>p.classList.remove('activa'));
  document.getElementById('n-'+pantallas[indice]).classList.add('activa');
  actual=indice;
  window.scrollTo({top:0,behavior:'smooth'});
}

function elegirUna(etiqueta){
  const nombre=etiqueta.querySelector('input').name;
  document.querySelectorAll(`input[name="${nombre}"]`).forEach(i=>{
    if(i.closest('.opcion'))i.closest('.opcion').classList.remove('seleccionada');
  });
  etiqueta.classList.add('seleccionada');
  etiqueta.querySelector('input').checked=true;
}

function elegirTarjeta(tarjeta){
  document.querySelectorAll('.tarjeta-empaque').forEach(c=>c.classList.remove('seleccionada'));
  tarjeta.classList.add('seleccionada');
  tarjeta.querySelector('input').checked=true;
}

function alternarChequeo(item){
  const caja=item.querySelector('input');
  caja.checked=!caja.checked;
  item.classList.toggle('seleccionada',caja.checked);
}

function actualizarBarra(nombre,valor){
  barras[nombre]=parseInt(valor);
  const etiquetas={precio:'Precio',funcional:'Resistencia a grasa y vapor',certif:'Certificación biodegradable',marca:'Personalización con mi marca'};
  document.getElementById('d-'+nombre).innerHTML=`${etiquetas[nombre]} — <b>${valor}</b> de 10`;
}

function validarYSiguiente(actual,siguiente){
  ir(actual);
  setTimeout(()=>ir(siguiente),50);
}

function finalizar(){
  let puntaje=100;
  const dec=document.querySelector('input[name="neg_decision"]:checked');
  if(dec){if(dec.value==='def_si')puntaje+=40;else if(dec.value==='prob_si')puntaje+=25;else if(dec.value==='prob_no')puntaje-=20;}
  const ley=document.querySelector('input[name="neg_ley1"]:checked');
  if(ley && ley.value==='ya_migre')puntaje+=20;
  const pago=document.querySelector('input[name="neg_pago"]:checked');
  if(pago){const v=pago.value;if(v==='20'||v==='30'||v==='al_cliente')puntaje+=15;}
  puntaje+=barras.funcional*1.5;
  puntaje+=barras.certif*1.0;

  document.getElementById('puntajeNegocio').textContent=Math.round(puntaje)+' ECO-PTOS';

  let nivel,descripcion,rec1,rec2,rec3;
  if(puntaje>=180){
    nivel='🌿 Líder Verde';
    descripcion='Tu negocio ya está pensando en el futuro del empaque. Serías un aliado ideal para el piloto.';
    rec1='Tienes una visión adelantada del cambio regulatorio.';
    rec2='Valoras más la función y la certificación que solo el precio.';
    rec3='Estás dispuesto a asumir un sobrecosto si hay valor de marca.';
  }else if(puntaje>=130){
    nivel='🥑 Consciente y Pragmático';
    descripcion='Te importa el planeta, pero tus decisiones siguen pasando por los números. Equilibrio sano.';
    rec1='Sabes que el cambio viene y te estás preparando.';
    rec2='Tu principal barrera es el precio o falta de proveedores confiables.';
    rec3='Un piloto gratuito con descuento de lanzamiento sería tu empujón.';
  }else if(puntaje>=80){
    nivel='🍔 Operativo Tradicional';
    descripcion='Tu foco ahora es producir y vender: el empaque es funcional, no estratégico. Típico del negocio joven.';
    rec1='Aún no ves el empaque como ventaja competitiva.';
    rec2='Tu dolor principal son las quejas operativas, no la sostenibilidad.';
    rec3='Te convencería un piloto que mejore la operación y reduzca quejas.';
  }else{
    nivel='🌭 Neutral';
    descripcion='Aún no has conectado el empaque con tu propuesta de valor. Perfecto: este diagnóstico es tu punto de partida.';
    rec1='Necesitas ver el caso concreto para decidirte.';
    rec2='No estás al tanto de la Ley 2232 ni de sus beneficios.';
    rec3='Un piloto gratis sería el mejor primer paso para ti.';
  }

  document.getElementById('nivelNegocio').textContent=nivel;
  document.getElementById('descripcionNegocio').textContent=descripcion;
  document.getElementById('recomendacion1').textContent=rec1;
  document.getElementById('recomendacion2').textContent=rec2;
  document.getElementById('recomendacion3').textContent=rec3;

  ir(10);
}

function enviarResultado(){
  const paquete=recolectarNegocio();
  console.log('📤 EcoEstructura · respuestas del negocio:',paquete);
  alert('✅ ¡Gracias! Te contactaremos para la prueba piloto.\n\n(Demo: en producción conecta a Google Forms o tu sistema interno)');
}

function recolectarNegocio(){
