<script>
const pantallas = ['inicio','perfil','frecuencia','favoritos','fricciones','deslizar','ordenar','pago','ley','abierta','resultado'];
let actual = 0;
const datos = {empaques:{},varios:{}};

function ir(indice){
  document.querySelectorAll('.pantalla').forEach(p=>p.classList.remove('activa'));
  document.getElementById('c-'+pantallas[indice]).classList.add('activa');
  actual = indice;
  window.scrollTo({top:0,behavior:'smooth'});
}

function elegirUna(etiqueta){
  const nombre = etiqueta.querySelector('input').name;
  document.querySelectorAll(`input[name="${nombre}"]`).forEach(i=>{
    if(i.closest('.opcion')) i.closest('.opcion').classList.remove('seleccionada');
  });
  etiqueta.classList.add('seleccionada');
  etiqueta.querySelector('input').checked = true;
}

function elegirVarias(etiqueta,grupo,maximo){
  const caja = etiqueta.querySelector('input[type="checkbox"]');
  const elementos = document.querySelectorAll(`[data-grupo="${grupo}"]`);
  let seleccionadas = Array.from(elementos).filter(el=>el.querySelector('input').checked);
  if(caja.checked && seleccionadas.length>maximo){
    caja.checked = false;
    console.log(`💡 Solo puedes elegir ${maximo} opciones`);
    return;
  }
  etiqueta.classList.toggle('seleccionada',caja.checked);
}

function elegirEmpaque(boton,empaque,veredicto){
  const tarjeta = boton.closest('.tarjeta-deslizar');
  tarjeta.querySelectorAll('.boton-deslizar').forEach(b=>{
    b.style.opacity='.5';
    b.style.transform='scale(.95)';
  });
  boton.style.opacity='1';
  boton.style.transform='scale(1.1)';
  boton.style.boxShadow='0 4px 12px rgba(0,0,0,.18)';
  datos.empaques[empaque]=veredicto;
  setTimeout(()=>{
    tarjeta.style.transition='all .3s';
    tarjeta.style.transform='translateX(40px)';
    tarjeta.style.opacity='.5';
  },350);
}

function validarYSiguiente(actual,siguiente){
  ir(actual);
  setTimeout(()=>ir(siguiente),50);
}

function finalizar(){
  let puntaje = 100;
  let eco = 0;
  if(datos.empaques.B==='si' || datos.empaques.C==='si') eco+=30;
  if(datos.empaques.A==='no') eco+=20;

  const pago = document.querySelector('input[name="pre_pago"]:checked');
  if(pago){
    const v = pago.value;
    if(v==='1500') puntaje+=15;
    if(v==='2500' || v==='3000+') puntaje+=25;
  }

  const ley = document.querySelector('input[name="pre_ley_imp"]:checked');
  if(ley && parseInt(ley.value)>=4) puntaje+=15;

  const una = document.querySelector('input[name="pre_una"]:checked');
  if(una && (una.value==='ecologico'||una.value==='rigido')) eco+=20;

  document.getElementById('puntaje-final').textContent = puntaje + ' ECO-PTOS';

  let nivel,descripcion;
  if(puntaje>=140){nivel='🌿 Embajador Verde';descripcion='Wow, eres un crack consciente. Tu voz pesa muchísimo para el proyecto.';}
  else if(puntaje>=110){nivel='🥑 Consumidor Consciente';descripcion='Te importa el planeta y el buen comer. Gran combinación.';}
  else if(puntaje>=80){nivel='🍔 Comensal Pragmático';descripcion='Primero el sabor, después el planeta, pero te importa.';}
  else{nivel='🌭 Neutral Informado';descripcion='Aún no lo tienes claro, y está bien. Tu opinión también vale.';}

  document.getElementById('etiqueta-nivel').textContent = nivel;
  document.getElementById('descripcion-nivel').textContent = descripcion;

  ir(10);
}

function enviarResultado(){
  const paquete = recolectarTodo();
  console.log('📤 EcoEstructura · respuestas del consumidor:',paquete);
  alert('✅ ¡Listo! Gracias por participar.\n\n(En producción: conecta este formulario a tu backend, Google Forms o Typeform)');
}

function recolectarTodo(){
  const salida = {tipo:'consumidor',edad:document.getElementById('pre_edad').value,ocupacion:document.getElementById('pre_ocupacion').value,zona:document.getElementById('pre_zona').value};
  document.querySelectorAll('input[type="radio"]:checked').forEach(r=>salida[r.name]=r.value);
  document.querySelectorAll('input[type="checkbox"]:checked').forEach(c=>{
    salida[c.name]=salida[c.name]?(salida[c.name]+','+c.value):c.value;
  });
  salida.empaques=datos.empaques;
  salida.peor_experiencia=document.getElementById('pre_peor').value;
  salida.contacto=document.getElementById('pre_contacto').value;
  return salida;
}

// arrastrar y ordenar
let arrastrado=null;
document.querySelectorAll('.item-ordenar').forEach(item=>{
  item.addEventListener('dragstart',e=>{
    arrastrado=item;
    item.classList.add('arrastrando');
    e.dataTransfer.effectAllowed='move';
  });
  item.addEventListener('dragend',e=>{
    item.classList.remove('arrastrando');
    actualizarPosiciones();
  });
  item.addEventListener('dragover',e=>{
    e.preventDefault();
    const lista=item.parentNode;
    const rect=item.getBoundingClientRect();
    const despues=(e.clientY-rect.top)/rect.height>.5;
    lista.insertBefore(arrastrado, despues?item.nextSibling:item);
  });
});

function actualizarPosiciones(){
  document.querySelectorAll('#lista-ordenar .item-ordenar').forEach((it,i)=>{
    it.querySelector('.posicion').textContent='#'+(i+1);
  });
}

// contador de caracteres
document.getElementById('pre_peor').addEventListener('input',e=>{
  document.getElementById('contador').textContent=e.target.value.length;
});
</script>
